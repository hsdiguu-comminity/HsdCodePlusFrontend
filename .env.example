# ============================================================
#  HSD Platform - E-POSTA AYARLARI (şifremi unuttum için)
#  Kullanım: bu dosyanın kopyasını ".env.local" adıyla oluştur,
#  değerleri doldur, sonra "npm run dev" komutunu yeniden başlat.
#  ".env.local" dosyası asla paylaşılmaz / GitHub'a yüklenmez.
# ============================================================

# Şifre sıfırlama bağlantısını imzalamak için gizli anahtar.
# En az 32 karakterlik rastgele bir metin yaz (ör. şifre üreticiyle).
RESET_SECRET=buraya-uzun-ve-rastgele-bir-metin-yaz-en-az-32-karakter

# E-posta sunucusu (SMTP). Gmail örneği:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
#   SMTP_USER=senin@gmail.com SMTP_PASS=<Gmail "Uygulama şifresi">
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Gönderen adı (isteğe bağlı)
MAIL_FROM="HSDCode+ <senin@gmail.com>"

# Sitenin adresi (şifre sıfırlama bağlantısında kullanılır)
SITE_URL=http://localhost:3000
